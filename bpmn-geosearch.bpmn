<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Search" targetNamespace="https://example.org/search-reconstruction" name="Формирование поисковой страницы">
  <bpmn:message id="Message_Request" name="Поисковый запрос и контекст" />
  <bpmn:message id="Message_Page" name="Готовая страница" />
  <bpmn:message id="Message_Decision" name="Предложения, решение и версии моделей" />
  <bpmn:message id="Message_Actions" name="Показы, клики и действия" />
  <bpmn:error id="Error_Service" name="Ошибка вызова модели или сервиса" errorCode="SERVICE_FAILURE" />
  <bpmn:process id="Process_Search" name="BPMN — показ блока" isExecutable="false">
    <bpmn:laneSet id="Process_Search_Lanes">
      <bpmn:lane id="Sources" name="Оркестратор · получение ответов">
        <bpmn:flowNodeRef>Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Context</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Web</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WebTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WebError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WebFallback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WebMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Geo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GeoTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GeoError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GeoFallback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GeoMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Others</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OtherTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OtherError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OtherFallback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OtherMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Blender" name="Верхний блендер и сборщик страницы">
        <bpmn:flowNodeRef>HasBlocks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ScoreTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ScoreError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Threshold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>None</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DecisionMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Render</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Request" name="Получен запрос">
      <bpmn:messageEventDefinition id="Request_definition" messageRef="Message_Request" />
      <bpmn:outgoing>Process_Search_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Context" name="Подготовить текст, язык и регион">
      <bpmn:incoming>Process_Search_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Fork" name="">
      <bpmn:incoming>Process_Search_Flow_2</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Process_Search_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Process_Search_Flow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Web" name="Получить веб-ответ через кэш или поиск по индексу">
      <bpmn:incoming>Process_Search_Flow_3</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="WebTimer" name="400 мс" attachedToRef="Web" cancelActivity="true">
      <bpmn:timerEventDefinition id="WebTimer_definition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT0.4S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:outgoing>Process_Search_Flow_7</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="WebError" name="Ошибка" attachedToRef="Web" cancelActivity="true">
      <bpmn:errorEventDefinition id="WebError_definition" errorRef="Error_Service" />
      <bpmn:outgoing>Process_Search_Flow_8</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="WebFallback" name="Задать пустой веб-ответ и статус сбоя">
      <bpmn:incoming>Process_Search_Flow_7</bpmn:incoming>
      <bpmn:incoming>Process_Search_Flow_8</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="WebMerge" name="">
      <bpmn:incoming>Process_Search_Flow_6</bpmn:incoming>
      <bpmn:incoming>Process_Search_Flow_9</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Geo" name="Подготовить геопредложение&#10;См. Process_Geo" calledElement="Process_Geo">
      <bpmn:incoming>Process_Search_Flow_4</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_10</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="GeoTimer" name="300 мс" attachedToRef="Geo" cancelActivity="true">
      <bpmn:timerEventDefinition id="GeoTimer_definition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT0.3S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:outgoing>Process_Search_Flow_11</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="GeoError" name="Ошибка" attachedToRef="Geo" cancelActivity="true">
      <bpmn:errorEventDefinition id="GeoError_definition" errorRef="Error_Service" />
      <bpmn:outgoing>Process_Search_Flow_12</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="GeoFallback" name="Задать пустое геопредложение и статус сбоя">
      <bpmn:incoming>Process_Search_Flow_11</bpmn:incoming>
      <bpmn:incoming>Process_Search_Flow_12</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GeoMerge" name="">
      <bpmn:incoming>Process_Search_Flow_10</bpmn:incoming>
      <bpmn:incoming>Process_Search_Flow_13</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Others" name="Получить предложение вертикали&#10;Кино, энциклопедия, …">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
      <bpmn:incoming>Process_Search_Flow_5</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="OtherTimer" name="300 мс" attachedToRef="Others" cancelActivity="true">
      <bpmn:timerEventDefinition id="OtherTimer_definition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT0.3S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:outgoing>Process_Search_Flow_15</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="OtherError" name="Ошибка" attachedToRef="Others" cancelActivity="true">
      <bpmn:errorEventDefinition id="OtherError_definition" errorRef="Error_Service" />
      <bpmn:outgoing>Process_Search_Flow_16</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="OtherFallback" name="Взять накопленные ответы; недоступные пометить пустыми">
      <bpmn:incoming>Process_Search_Flow_15</bpmn:incoming>
      <bpmn:incoming>Process_Search_Flow_16</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="OtherMerge" name="">
      <bpmn:incoming>Process_Search_Flow_14</bpmn:incoming>
      <bpmn:incoming>Process_Search_Flow_17</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Join" name="">
      <bpmn:incoming>Process_Search_Flow_18</bpmn:incoming>
      <bpmn:incoming>Process_Search_Flow_19</bpmn:incoming>
      <bpmn:incoming>Process_Search_Flow_20</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_21</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:textAnnotation id="MainNote">
      <bpmn:text>Вертикали вызываются параллельно.
Ответы сохраняются по request_id.
При сборке у каждой ветки есть ответ или статус сбоя.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="Process_Search_Flow_1" sourceRef="Request" targetRef="Context" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_2" sourceRef="Context" targetRef="Fork" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_3" sourceRef="Fork" targetRef="Web" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_4" sourceRef="Fork" targetRef="Geo" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_5" sourceRef="Fork" targetRef="Others" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_6" sourceRef="Web" targetRef="WebMerge" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_7" sourceRef="WebTimer" targetRef="WebFallback" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_8" sourceRef="WebError" targetRef="WebFallback" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_9" sourceRef="WebFallback" targetRef="WebMerge" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_10" sourceRef="Geo" targetRef="GeoMerge" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_11" sourceRef="GeoTimer" targetRef="GeoFallback" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_12" sourceRef="GeoError" targetRef="GeoFallback" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_13" sourceRef="GeoFallback" targetRef="GeoMerge" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_14" sourceRef="Others" targetRef="OtherMerge" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_15" sourceRef="OtherTimer" targetRef="OtherFallback" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_16" sourceRef="OtherError" targetRef="OtherFallback" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_17" sourceRef="OtherFallback" targetRef="OtherMerge" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_18" sourceRef="WebMerge" targetRef="Join" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_19" sourceRef="GeoMerge" targetRef="Join" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_20" sourceRef="OtherMerge" targetRef="Join" name="" />
    <bpmn:exclusiveGateway id="HasBlocks" name="Есть валидные блоки?" default="Process_Search_Flow_23">
      <bpmn:incoming>Process_Search_Flow_21</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_22</bpmn:outgoing>
      <bpmn:outgoing>Process_Search_Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Score" name="Посчитать общий скор полезности каждого блока">
      <bpmn:incoming>Process_Search_Flow_22</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="ScoreTimer" name="50 мс" attachedToRef="Score" cancelActivity="true">
      <bpmn:timerEventDefinition id="ScoreTimer_definition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT0.05S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:outgoing>Process_Search_Flow_25</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="ScoreError" name="Ошибка" attachedToRef="Score" cancelActivity="true">
      <bpmn:errorEventDefinition id="ScoreError_definition" errorRef="Error_Service" />
      <bpmn:outgoing>Process_Search_Flow_26</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Threshold" name="Есть скор ≥ 0,70?" default="Process_Search_Flow_28">
      <bpmn:incoming>Process_Search_Flow_24</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_27</bpmn:outgoing>
      <bpmn:outgoing>Process_Search_Flow_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Choose" name="Выбрать блок с максимальным скором">
      <bpmn:incoming>Process_Search_Flow_27</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="None" name="Зафиксировать отсутствие специального блока">
      <bpmn:incoming>Process_Search_Flow_23</bpmn:incoming>
      <bpmn:incoming>Process_Search_Flow_25</bpmn:incoming>
      <bpmn:incoming>Process_Search_Flow_26</bpmn:incoming>
      <bpmn:incoming>Process_Search_Flow_28</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="DecisionMerge" name="">
      <bpmn:incoming>Process_Search_Flow_29</bpmn:incoming>
      <bpmn:incoming>Process_Search_Flow_30</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Log" name="Опубликовать событие решения">
      <bpmn:messageEventDefinition id="Log_definition" messageRef="Message_Decision" />
      <bpmn:incoming>Process_Search_Flow_31</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_32</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="Render" name="Собрать страницу из доступных веб-результатов и блока">
      <bpmn:incoming>Process_Search_Flow_32</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Send" name="Отправить страницу пользователю">
      <bpmn:incoming>Process_Search_Flow_33</bpmn:incoming>
      <bpmn:outgoing>Process_Search_Flow_34</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Done" name="Страница отправлена">
      <bpmn:incoming>Process_Search_Flow_34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Process_Search_Flow_21" sourceRef="Join" targetRef="HasBlocks" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_22" sourceRef="HasBlocks" targetRef="Score" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">valid_blocks_count &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Process_Search_Flow_23" sourceRef="HasBlocks" targetRef="None" name="Нет" />
    <bpmn:sequenceFlow id="Process_Search_Flow_24" sourceRef="Score" targetRef="Threshold" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_25" sourceRef="ScoreTimer" targetRef="None" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_26" sourceRef="ScoreError" targetRef="None" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_27" sourceRef="Threshold" targetRef="Choose" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">max_utility_score &gt;= 0.70</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Process_Search_Flow_28" sourceRef="Threshold" targetRef="None" name="Нет" />
    <bpmn:sequenceFlow id="Process_Search_Flow_29" sourceRef="Choose" targetRef="DecisionMerge" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_30" sourceRef="None" targetRef="DecisionMerge" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_31" sourceRef="DecisionMerge" targetRef="Log" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_32" sourceRef="Log" targetRef="Render" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_33" sourceRef="Render" targetRef="Send" name="" />
    <bpmn:sequenceFlow id="Process_Search_Flow_34" sourceRef="Send" targetRef="Done" name="" />
  </bpmn:process>
  <bpmn:collaboration id="Process_Search_Collaboration">
    <bpmn:participant id="User" name="Пользователь" />
    <bpmn:participant id="Search" name="Система формирования поисковой страницы" processRef="Process_Search" />
    <bpmn:participant id="Quality" name="Платформа обучения и оценки · разметка выборки, оценка по срезам, обучение и публикация моделей" />
    <bpmn:messageFlow id="Process_Search_Flow_35" sourceRef="User" targetRef="Request" name="Запрос и контекст" />
    <bpmn:messageFlow id="Process_Search_Flow_36" sourceRef="Send" targetRef="User" name="Готовая страница" />
    <bpmn:messageFlow id="Process_Search_Flow_37" sourceRef="Log" targetRef="Quality" name="Все предложения, решение, версии" />
    <bpmn:messageFlow id="Process_Search_Flow_38" sourceRef="User" targetRef="Quality" name="Показы и действия после ответа" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Geo" name="BPMN — геопоиск" isExecutable="false">
    <bpmn:laneSet id="Process_Geo_Lanes">
      <bpmn:lane id="Retrieval" name="Геопоиск · кандидаты и признаки">
        <bpmn:flowNodeRef>GeoStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GeoFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Key</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReadCache</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CacheHit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cached</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retrieve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WriteCache</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CacheMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Features</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Classify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FeaturesJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Filter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Candidates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Models" name="Геопоиск и ML-сервис · оценка и подготовка ответа">
        <bpmn:flowNodeRef>Rank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Survived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Empty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Format</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Single</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Many</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FormatMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReturnMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GeoEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GeoStart" name="Получен контекст вызова">
      <bpmn:outgoing>Process_Geo_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="GeoFork" name="">
      <bpmn:incoming>Process_Geo_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Process_Geo_Flow_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Key" name="Построить ключ кэша&#10;Запрос, язык, область, версия индекса">
      <bpmn:incoming>Process_Geo_Flow_2</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ReadCache" name="Проверить геокэш кандидатов">
      <bpmn:incoming>Process_Geo_Flow_4</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CacheHit" name="Есть свежая запись?" default="Process_Geo_Flow_7">
      <bpmn:incoming>Process_Geo_Flow_5</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Process_Geo_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Cached" name="Получить ID из кэша">
      <bpmn:incoming>Process_Geo_Flow_6</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Retrieve" name="Найти кандидатов по инвертированному индексу">
      <bpmn:incoming>Process_Geo_Flow_7</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="WriteCache" name="Записать ID кандидатов в кэш">
      <bpmn:incoming>Process_Geo_Flow_8</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CacheMerge" name="">
      <bpmn:incoming>Process_Geo_Flow_9</bpmn:incoming>
      <bpmn:incoming>Process_Geo_Flow_10</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Features" name="Получить актуальные признаки организаций и топонимов">
      <bpmn:incoming>Process_Geo_Flow_11</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Classify" name="ML · оценить геоинтент, org1/manyorg и признаки запроса">
      <bpmn:incoming>Process_Geo_Flow_3</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="FeaturesJoin" name="">
      <bpmn:incoming>Process_Geo_Flow_12</bpmn:incoming>
      <bpmn:incoming>Process_Geo_Flow_13</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Filter" name="ML · применить ранние фильтры по запросу, контексту и объекту">
      <bpmn:incoming>Process_Geo_Flow_14</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Candidates" name="Есть кандидаты?" default="Process_Geo_Flow_17">
      <bpmn:incoming>Process_Geo_Flow_15</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Process_Geo_Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:textAnnotation id="GeoNote">
      <bpmn:text>org1/manyorg определяется для каждого запроса.
Число найденных объектов влияет на формат блока.
Веб-признаки поступают только в верхний блендер.
Модели используют совместимые схемы признаков.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:serviceTask id="Rank" name="ML · ранжировать сокращённый набор и применить фильтр v2">
      <bpmn:incoming>Process_Geo_Flow_16</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Survived" name="Есть прошедшие фильтр?" default="Process_Geo_Flow_20">
      <bpmn:incoming>Process_Geo_Flow_18</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Process_Geo_Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Empty" name="Вернуть статус empty и признаки запроса">
      <bpmn:incoming>Process_Geo_Flow_17</bpmn:incoming>
      <bpmn:incoming>Process_Geo_Flow_20</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Format" name="Какой формат?" default="Process_Geo_Flow_22">
      <bpmn:incoming>Process_Geo_Flow_19</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Process_Geo_Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Single" name="Собрать карточку топ-1">
      <bpmn:incoming>Process_Geo_Flow_21</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Many" name="Собрать список лучших организаций">
      <bpmn:incoming>Process_Geo_Flow_22</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="FormatMerge" name="">
      <bpmn:incoming>Process_Geo_Flow_23</bpmn:incoming>
      <bpmn:incoming>Process_Geo_Flow_24</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Offer" name="Вернуть геопредложение&#10;Содержимое, признаки, версии и статус ok">
      <bpmn:incoming>Process_Geo_Flow_25</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ReturnMerge" name="">
      <bpmn:incoming>Process_Geo_Flow_26</bpmn:incoming>
      <bpmn:incoming>Process_Geo_Flow_27</bpmn:incoming>
      <bpmn:outgoing>Process_Geo_Flow_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="GeoEnd" name="Геоветвь завершена">
      <bpmn:incoming>Process_Geo_Flow_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="FailureNote">
      <bpmn:text>Ошибки ML или индекса передаются вызывающему процессу.
Граничные Error и Timer у задачи Geo в основной схеме
превращают сбой в пустое предложение со статусом.
Недоступность кэша считается cache miss. Запись best effort.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="Process_Geo_Flow_1" sourceRef="GeoStart" targetRef="GeoFork" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_2" sourceRef="GeoFork" targetRef="Key" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_3" sourceRef="GeoFork" targetRef="Classify" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_4" sourceRef="Key" targetRef="ReadCache" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_5" sourceRef="ReadCache" targetRef="CacheHit" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_6" sourceRef="CacheHit" targetRef="Cached" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">cache_hit and cache_version_matches</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Process_Geo_Flow_7" sourceRef="CacheHit" targetRef="Retrieve" name="Нет / сбой" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_8" sourceRef="Retrieve" targetRef="WriteCache" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_9" sourceRef="Cached" targetRef="CacheMerge" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_10" sourceRef="WriteCache" targetRef="CacheMerge" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_11" sourceRef="CacheMerge" targetRef="Features" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_12" sourceRef="Features" targetRef="FeaturesJoin" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_13" sourceRef="Classify" targetRef="FeaturesJoin" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_14" sourceRef="FeaturesJoin" targetRef="Filter" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_15" sourceRef="Filter" targetRef="Candidates" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_16" sourceRef="Candidates" targetRef="Rank" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">candidate_count &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Process_Geo_Flow_17" sourceRef="Candidates" targetRef="Empty" name="Нет" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_18" sourceRef="Rank" targetRef="Survived" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_19" sourceRef="Survived" targetRef="Format" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">survivor_count &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Process_Geo_Flow_20" sourceRef="Survived" targetRef="Empty" name="Нет" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_21" sourceRef="Format" targetRef="Single" name="org1 или 1 объект">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">request_kind == "org1" or survivor_count == 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Process_Geo_Flow_22" sourceRef="Format" targetRef="Many" name="manyorg и ≥ 2" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_23" sourceRef="Single" targetRef="FormatMerge" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_24" sourceRef="Many" targetRef="FormatMerge" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_25" sourceRef="FormatMerge" targetRef="Offer" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_26" sourceRef="Offer" targetRef="ReturnMerge" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_27" sourceRef="Empty" targetRef="ReturnMerge" name="" />
    <bpmn:sequenceFlow id="Process_Geo_Flow_28" sourceRef="ReturnMerge" targetRef="GeoEnd" name="" />
  </bpmn:process>
