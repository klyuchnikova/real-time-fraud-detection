        },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 10
      }
    },
    {
      "id": 6,
      "title": "Результаты по версии",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT model_version, count(*) AS scores, avg(fraud_flag)::float AS fraud_share FROM monitoring_scores WHERE has_context AND ('__all_values__' IN (${state:sqlstring}) OR us_state IN (${state:sqlstring})) AND ('__all_values__' IN (${merchant:sqlstring}) OR merch IN (${merchant:sqlstring})) AND $__timeFilter(scored_at) GROUP BY model_version ORDER BY scores DESC",
          "format": "table",
