            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "text": {
          "titleSize": 22,
          "valueSize": 48
        }
      }
    },
    {
      "id": 5,
      "title": "Сумма операций с флагом по категориям",
      "type": "barchart",
      "description": "Сумма помеченных моделью операций; не подтверждённые потери и не предотвращённый ущерб.",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT cat_id, coalesce(sum(amount) FILTER (WHERE fraud_flag=1),0)::float AS flagged_amount FROM monitoring_scores WHERE has_context AND ('__all_values__' IN (${state:sqlstring}) OR us_state IN (${state:sqlstring})) AND ('__all_values__' IN (${merchant:sqlstring}) OR merch IN (${merchant:sqlstring})) AND $__timeFilter(scored_at) GROUP BY cat_id ORDER BY flagged_amount DESC NULLS LAST",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
